# Neon PostgreSQL connection string (Neon dashboard → Connect). Use the pooled URL.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Cloudflare R2 (Dashboard → R2 → Manage API tokens → Object Read & Write, scoped to the bucket)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="petrichor-photos"
# Public base URL for the bucket: the r2.dev subdomain or a custom domain, without a trailing slash
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Public contact address shown as "Contact us" (e.g. for editions of more than 20 cards)
NEXT_PUBLIC_CONTACT_EMAIL=""

# Neon Auth (Managed Better Auth). `neon deploy` / `neon env pull` write the URLs.
NEON_AUTH_BASE_URL=""
NEON_AUTH_JWKS_URL=""
# Secret for session cookies (32+ chars): openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""
